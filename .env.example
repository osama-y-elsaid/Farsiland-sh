# ---- Admin --------------------------------------------------------
# The only thing protecting your prices and your order list. 30+ random
# characters:  openssl rand -base64 32
ADMIN_TOKEN=

# ---- Payments (Stripe) --------------------------------------------
# The matching pk_live_/pk_test_ key goes in public/index.html ->
# CONFIG.stripePublishableKey. Never put the secret key there.
STRIPE_SECRET_KEY=

# ---- Email receipts -----------------------------------------------
# Pick ONE. On Netlify use an HTTP provider — outbound SMTP from a
# serverless function is slow and sometimes blocked.
POSTMARK_TOKEN=
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Farsiland Slaughterhouse" <orders@yourdomain.com>

# ---- Shop ---------------------------------------------------------
SHOP_EMAIL=orders@yourdomain.com
SHOP_PHONE=
TAX_RATE=0

# ---- Node hosts only (Render, Railway, Fly, a VPS) ----------------
# Point at a PERSISTENT disk or every order is lost on redeploy.
# Not used on Netlify — that stores data in Netlify Blobs.
DATA_DIR=
PORT=4242
